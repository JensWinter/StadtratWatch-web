---
import { type SessionSpeech } from '@models/session-speech';
import { getFactionOfPerson, getPersonByName } from '@utils/session-utils';
import { type Registry, type RegistrySession } from '@models/registry';

type Props = {
  parliamentPeriod: Registry;
  session: RegistrySession;
  speech: SessionSpeech;
  speechElementId: string;
  link: string;
};

const { parliamentPeriod, session, speech, speechElementId, link } =
  Astro.props as Props;

const person = getPersonByName(parliamentPeriod, session, speech.speaker);
const faction = person
  ? getFactionOfPerson(parliamentPeriod, session, person)
  : null;

const youtubeUrl = getYoutubeUrl(session.youtubeUrl, speech.start);
const linkTitle = getLinkTitle(speech.speaker, session.date);
const hintMailHref = getHintMailHref(speech, session.date);
const hintMailTitle = getHintMailTitle(speech);

function getYoutubeUrl(baseUrl: string, start: number): string {
  return `${baseUrl}?t=${start}`;
}

function getLinkTitle(speaker: string, date: string): string {
  const formattedDate = new Date(date).toLocaleString('de-DE', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  });
  return `Redebeitrag von ${speaker} am ${formattedDate}`;
}

function getHintMailHref(speech: SessionSpeech, date: string): string {
  const formattedDate = new Date(date).toLocaleString('de-DE', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  });
  const subject = encodeURIComponent(
    `Hinweis zum Redebeitrag von ${speech.speaker} am ${formattedDate}`,
  );
  const hintMailBodyText = encodeURIComponent(
    `Hallo StadtratWatch-Team!

Ich habe einen Hinweis zum Redebeitrag von ${speech.speaker} aus der Sitzung vom ${formattedDate} (Zeitmarke: ${speech.start}):




Mit freundlichen Grüßen,

`,
  );
  return `mailto:stadtratwatch@gmail.com?subject=${subject}&body=${hintMailBodyText}`;
}

function getHintMailTitle(speech: SessionSpeech): string {
  return `Hinweis zum Redebeitrag von ${speech.speaker} geben`;
}

// PROTOTYPE MOCK for issue #509 — stands in for the real `aiTextAssessment`
// field (#507/#508, not yet implemented). Flags ~1 in 5 speeches so the
// badge is actually visible while reviewing. Delete with the rest of this
// prototype.
type MockAiTextAssessment = { label: 'AI' | 'Mixed' };

function mockAiTextAssessment(
  speech: SessionSpeech,
): MockAiTextAssessment | null {
  const seed = `${speech.speaker}-${speech.start}`;
  let hash = 0;
  for (const char of seed) {
    hash = (hash * 31 + char.charCodeAt(0)) >>> 0;
  }
  if (hash % 5 !== 0) {
    return null;
  }
  return { label: hash % 2 === 0 ? 'AI' : 'Mixed' };
}

const aiAssessment = mockAiTextAssessment(speech);
const aiBadgeTooltip =
  'Automatisierte Einschätzung eines KI-Textdetektors (Pangram) für diesen Redebeitrag. Mehr zur Methodik.';
const methodikHref = '/methodik#ki-einschaetzung';
---

<div
  id={speechElementId}
  class="timeline-start text-sm flex flex-row flex-wrap gap-2 w-full items-center"
>
  <span class="text-base-content/80">{speech.speaker}</span>
  {
    aiAssessment && (
      <a
        href={methodikHref}
        data-ai-badge-variant="C"
        class="ai-badge-variant hidden tooltip tooltip-bottom"
        data-tip={aiBadgeTooltip}
        aria-label={aiBadgeTooltip}
      >
        <span class="iconify lucide--bot size-4 text-warning align-middle" />
      </a>
    )
  }
  {faction && <span class="badge badge-sm badge-neutral">{faction.name}</span>}
  {
    speech.onBehalfOf && (
      <span class="badge badge-sm badge-neutral">{speech.onBehalfOf}</span>
    )
  }
  {
    aiAssessment && (
      <span
        data-ai-badge-variant="A"
        class="ai-badge-variant hidden badge badge-sm badge-soft badge-warning tooltip tooltip-bottom"
        data-tip={aiBadgeTooltip}
      >
        <a
          href={methodikHref}
          class="flex items-center gap-1"
          aria-label={aiBadgeTooltip}
        >
          <span class="iconify lucide--bot size-3" />
          KI-Einschätzung
        </a>
      </span>
    )
  }
  <div class="dropdown dropdown-end ml-auto">
    <button tabindex="0" class="btn btn-sm btn-ghost">
      <span class="iconify lucide--more-horizontal"></span>
    </button>
    <ul
      tabindex="0"
      class="dropdown-content menu p-2 shadow bg-base-200 rounded-box w-60"
    >
      {
        aiAssessment && (
          <li data-ai-badge-variant="B" class="ai-badge-variant hidden">
            <a
              href={methodikHref}
              title="Einschätzung eines KI-Textdetektors"
              aria-label={aiBadgeTooltip}
            >
              <span class="iconify lucide--bot" />
              KI-Einschätzung
            </a>
          </li>
        )
      }
      <li>
        <a
          class="copy-speech-link-btn"
          href={`${link}#${speechElementId}`}
          title={linkTitle}
          aria-label={linkTitle}
        >
          <span class="iconify lucide--link"></span>
          Link zum Beitrag kopieren
        </a>
      </li>
      <li>
        <a href={hintMailHref} title={hintMailTitle} aria-label={hintMailTitle}>
          <span class="iconify lucide--flag"></span>
          Beitrag melden
        </a>
      </li>
    </ul>
  </div>
</div>
<div class="timeline-middle">
  <div
    class="bg-base-200 grid place-items-center rounded-full border border-base-300 p-1"
  >
    <span class="iconify lucide--message-circle"></span>
  </div>
</div>
<div class="timeline-end timeline-box w-full">
  <div class="space-y-3">
    {(speech.transcription || '').split('\n\n').map((line) => <p>{line}</p>)}
  </div>
  <div class="flex justify-between items-center mt-5">
    <a
      href={youtubeUrl}
      target="_blank"
      class="btn btn-soft btn-primary btn-sm flex flex-row items-center gap-1"
    >
      <span class="iconify lucide--youtube"></span>
      In YouTube öffnen
    </a>
  </div>
</div>

<script>
  // PROTOTYPE for issue #509 — delete together with the `ai-badge-variant`
  // markup above and src/components/prototype/AiBadgeVariantSwitcher.astro.
  function applyAiBadgeVariant() {
    const variant =
      new URLSearchParams(window.location.search).get('variant') || 'A';
    document.querySelectorAll('[data-ai-badge-variant]').forEach((el) => {
      el.classList.toggle(
        'hidden',
        el.getAttribute('data-ai-badge-variant') !== variant,
      );
    });
  }
  applyAiBadgeVariant();
  window.addEventListener('srw-prototype-variant-change', applyAiBadgeVariant);
  window.addEventListener('popstate', applyAiBadgeVariant);
</script>
